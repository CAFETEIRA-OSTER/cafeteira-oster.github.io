<?xml version="1.0" encoding="utf-8"?>
<AppInstaller
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018/05"
    Uri="https://cafeteira-oster.github.io/APPTESTE/Installers/Package.appinstaller"
    Version="1.0.1.2">
  <MainPackage
      Name="APPTESTE"
      Publisher="CN=labservice"
      Version="1.0.1.2"
      ProcessorArchitecture="x64"
      Uri="https://cafeteira-oster.github.io/APPTESTE/Installers/APPTESTE_x64.msix" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0"
              ShowPrompt="true"
              UpdateBlocksActivation="true" />
  </UpdateSettings>
</AppInstaller>
